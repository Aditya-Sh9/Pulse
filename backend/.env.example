PORT=5000

# Origin(s) allowed to call the API and open sockets. Comma-separate multiple origins.
# The first one is also used to build the signup link in invitation emails.
FRONTEND_URL=http://localhost:5173

# Timezone used for due-date reminders and nightly cleanup (IANA name)
APP_TIMEZONE=Asia/Kolkata

# Nodemailer SMTP Credentials
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

MONGO_URI=mongodb+srv://Username:Password@cluster0.abcde.mongodb.net/

# Optional: service account JSON as a single-line string (used on Render instead of config/serviceAccountKey.json)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
