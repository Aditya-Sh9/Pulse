rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Email/password accounts must confirm their address; Google sign-ins are already verified
    function verified() {
      return signedIn()
        && (request.auth.token.get('email_verified', false) == true
            || request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'password');
    }

    function isAdmin() {
      return verified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validStatus(s) {
      return s in ['TO DO', 'IN PROGRESS', 'COMPLETE'];
    }

    // Written only by the backend (status endpoint): completion, XP and recurrence bookkeeping
    function serverTaskFields() {
      return ['completedBy', 'completedAt', 'xpAwarded', 'recurrenceSpawned', 'recurrenceOf'];
    }

    match /spaces/{spaceId} {
      allow read: if verified();
      // Only admins can create or update spaces; deletes go through the backend (cascade)
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if verified();
      // Only admins can create or update projects; deletes go through the backend (cascade)
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if verified();

      // Employees may only assign new tasks to themselves (or leave them unassigned)
      allow create: if verified()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && validStatus(request.resource.data.status)
        && !request.resource.data.keys().hasAny(serverTaskFields())
        && (isAdmin() || request.resource.data.assigneeId in ['', request.auth.uid]);

      // Status, completion and XP bookkeeping are server-only (PATCH /api/tasks/:id/status)
      allow update: if verified()
        && !changed().hasAny(serverTaskFields().concat(['status', 'createdBy']))
        && (isAdmin()
            || !changed().hasAny(['assigneeId'])
            || request.resource.data.assigneeId in ['', request.auth.uid]);

      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if verified();
        allow create: if verified()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if verified() && (resource.data.userId == request.auth.uid || isAdmin());
      }

      match /activities/{activityId} {
        allow read: if verified();
        allow create: if verified() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /users/{userId} {
      // Unverified users can still read their own profile (role lookup on the confirmation screen)
      allow read: if verified() || (signedIn() && request.auth.uid == userId);

      // Self-signup always starts as an employee with zero XP
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'employee'
        && request.resource.data.get('productivityScore', 0) == 0
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'name', 'role', 'status', 'createdAt', 'updatedAt',
              'productivityScore', 'notifications', 'favoriteProjects', 'savedFilters']);

      // Users may edit their own profile fields, but never their role or XP
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == userId
            && changed().hasOnly(['name', 'notifications', 'status', 'updatedAt', 'favoriteProjects', 'savedFilters', 'desktopNotifications']));

      allow delete: if isAdmin();
    }

    // Archived leaderboard seasons are written by the backend only
    match /seasons/{seasonId} {
      allow read: if verified();
      allow write: if false;
    }

    match /notifications/{notifId} {
      allow read: if verified() && resource.data.userId == request.auth.uid;

      // Senders can't impersonate someone else
      allow create: if verified()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.read == false
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500;

      allow update: if verified()
        && resource.data.userId == request.auth.uid
        && changed().hasOnly(['read']);

      allow delete: if verified() && resource.data.userId == request.auth.uid;
    }
  }
}
